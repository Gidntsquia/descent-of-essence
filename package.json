{
  "name": "wordbound",
  "private": true,
  "description": "Dev-only tooling for the Wordbound/Descent of Essence static game. The game itself has no build step -- just open index.html or wordbound.html.",
  "scripts": {
    "pretest": "node tools/ensure-deps.js jsdom",
    "test": "node test/dom-check.js",
    "pretest:mobile": "node tools/ensure-deps.js @playwright/test",
    "test:mobile": "node test/verify-mobile-layout.js",
    "pretest:qa": "node tools/ensure-deps.js @playwright/test",
    "test:qa": "node test/orchestrator-qa-boss-reward.js",
    "test:drag-interrupt": "node test/verify-drag-interrupt.js",
    "build:itch": "node tools/build-itch.js",
    "pretest:itch-build": "node tools/ensure-deps.js @playwright/test",
    "test:itch-build": "node test/verify-itch-build.js",
    "prerecord:gameplay": "node tools/ensure-deps.js @playwright/test",
    "record:gameplay": "node tools/record-gameplay.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^25.0.0"
  }
}
